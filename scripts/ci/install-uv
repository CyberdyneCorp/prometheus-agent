#!/usr/bin/env bash
# Installs the uv this binary pins (crates/pmt-update/runtimes/index.json),
# verified against its SHA-256, into DEST (default: target/tools/uv), and
# installs the CPython the python-bridge tests run on into
# target/pybridge-python and the OpenAI SDK of the M2 exit test into
# target/openai-sdk, so no test downloads anything.
#
# usage: scripts/ci/install-uv [DEST]
# On GitHub Actions DEST is added to GITHUB_PATH.
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
dest=${1:-$root/target/tools/uv}

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) platform=darwin-arm64 ;;
    Darwin-x86_64) platform=darwin-x64 ;;
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64) platform=linux-arm64 ;;
    *) echo "install-uv: unsupported host $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

read -r url sha exe < <(python3 - "$root/crates/pmt-update/runtimes/index.json" "$platform" <<'PY'
import json, sys
artifact = json.load(open(sys.argv[1]))["runtimes"]["uv"]["artifacts"][sys.argv[2]]
print(artifact["url"], artifact["sha256"], artifact["exe"])
PY
)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl --fail --location --silent --show-error --retry 3 -o "$work/uv.tar.gz" "$url"
if command -v sha256sum >/dev/null; then
    actual=$(sha256sum "$work/uv.tar.gz" | cut -d' ' -f1)
else
    actual=$(shasum -a 256 "$work/uv.tar.gz" | cut -d' ' -f1)
fi
if [ "$actual" != "$sha" ]; then
    echo "install-uv: $url has SHA-256 $actual, the index pins $sha" >&2
    exit 1
fi
tar -xzf "$work/uv.tar.gz" -C "$work"
mkdir -p "$dest"
cp "$work/$exe" "$dest/uv"
chmod +x "$dest/uv"
if [ -n "${GITHUB_PATH:-}" ]; then
    echo "$dest" >>"$GITHUB_PATH"
fi
# The rust cache restores target/ partially (it prunes files it considers
# build output), which leaves a CPython uv sees as installed but broken
# (missing _sysconfigdata_, EXTERNALLY-MANAGED). Always install fresh.
rm -rf "$root/target/pybridge-python"
UV_PYTHON_INSTALL_REGISTRY=0 "$dest/uv" python install 3.12 --no-bin --install-dir "$root/target/pybridge-python"
# The official OpenAI Python SDK the M2 exit test drives against the API
# server (crates/prometheus/tests/m2_exit/openai_sdk.rs: keep the version,
# the cut-off date and the marker file in step with it).
rm -rf "$root/target/openai-sdk"
UV_PYTHON_INSTALL_DIR="$root/target/pybridge-python" "$dest/uv" venv --quiet \
    --python-preference only-managed --python 3.12 "$root/target/openai-sdk"
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) sdk_python="$root/target/openai-sdk/Scripts/python.exe" ;;
    *) sdk_python="$root/target/openai-sdk/bin/python" ;;
esac
"$dest/uv" pip install --quiet --exclude-newer 2026-11-01T00:00:00Z --python "$sdk_python" openai==2.8.0
touch "$root/target/openai-sdk/.openai-2.8.0"
echo "uv $("$dest/uv" --version) at $dest"
