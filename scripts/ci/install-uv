#!/usr/bin/env bash
# Installs the uv this binary pins (crates/pmt-update/runtimes/index.json),
# verified against its SHA-256, into DEST (default: target/tools/uv), and
# installs the CPython the python-bridge tests run on into
# target/pybridge-python, so no test downloads anything.
#
# usage: scripts/ci/install-uv [DEST]
# On GitHub Actions DEST is added to GITHUB_PATH.
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
dest=${1:-$root/target/tools/uv}

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) platform=darwin-arm64 ;;
    Darwin-x86_64) platform=darwin-x64 ;;
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64) platform=linux-arm64 ;;
    *) echo "install-uv: unsupported host $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

read -r url sha exe < <(python3 - "$root/crates/pmt-update/runtimes/index.json" "$platform" <<'PY'
import json, sys
artifact = json.load(open(sys.argv[1]))["runtimes"]["uv"]["artifacts"][sys.argv[2]]
print(artifact["url"], artifact["sha256"], artifact["exe"])
PY
)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl --fail --location --silent --show-error --retry 3 -o "$work/uv.tar.gz" "$url"
if command -v sha256sum >/dev/null; then
    actual=$(sha256sum "$work/uv.tar.gz" | cut -d' ' -f1)
else
    actual=$(shasum -a 256 "$work/uv.tar.gz" | cut -d' ' -f1)
fi
if [ "$actual" != "$sha" ]; then
    echo "install-uv: $url has SHA-256 $actual, the index pins $sha" >&2
    exit 1
fi
tar -xzf "$work/uv.tar.gz" -C "$work"
mkdir -p "$dest"
cp "$work/$exe" "$dest/uv"
chmod +x "$dest/uv"
if [ -n "${GITHUB_PATH:-}" ]; then
    echo "$dest" >>"$GITHUB_PATH"
fi
UV_PYTHON_INSTALL_REGISTRY=0 "$dest/uv" python install 3.12 --no-bin --install-dir "$root/target/pybridge-python"
echo "uv $("$dest/uv" --version) at $dest"
