#!/usr/bin/env bash
# TEMPORARY diagnostics: which Windows shells the terminal tool can start
# under each sandbox mode. Prints the observation of one `echo` call.
set -uo pipefail
bin=$1
work=$(mktemp -d "${RUNNER_TEMP:-/tmp}/diag.XXXXXX")
cat >"$work/script.toml" <<'TOML'
[[rule]]
step = 0
[[rule.tool_calls]]
name = "terminal"
arguments = { command = "echo hello-from-shell" }

[[rule]]
step = 1
text = "done"
TOML
for shell in git_bash powershell pwsh; do
    for mode in enforce off; do
        home="$work/home-$shell-$mode"
        echo "=== windows_shell=$shell sandbox=$mode"
        degraded='[]'
        [ "$mode" = off ] && degraded='["all"]'
        "$bin" --home "$home" --set "terminal.windows_shell=$shell" --set "security.sandbox.mode=$mode" \
            --set "security.sandbox.allow_degraded=$degraded" \
            chat -z go --provider mock --mock-script "$work/script.toml" --cwd "$work" </dev/null 2>&1 | tail -3
        id=$("$bin" --home "$home" --json sessions list --all 2>/dev/null | sed -n 's/.*"id":"\(ses_[^"]*\)".*/\1/p' | head -1)
        [ -n "$id" ] && "$bin" --home "$home" trajectory show "$id" 2>&1 | grep -A2 OBSERVATION
    done
done
exit 0
