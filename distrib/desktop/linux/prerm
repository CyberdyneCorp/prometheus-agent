#!/bin/sh
# Removes the /usr/bin/prometheus link on uninstall, not on upgrade: dpkg
# passes `remove` (`upgrade` otherwise), rpm passes 0 on erase (1 when an
# upgrade replaces the package).
set -e
case "$1" in
remove | purge | 0) ;;
*) exit 0 ;;
esac
if [ "$(readlink /usr/bin/prometheus || true)" = /usr/lib/prometheus-desktop/prometheus ]; then
    rm -f /usr/bin/prometheus
fi
