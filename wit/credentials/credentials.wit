/// Credentials the host holds for a plugin (spec: plugin-system, Host
/// credential handles). Imported by the `terminal-backend` world (1.2).
///
/// A plugin names a credential by an opaque handle granted in its
/// `credentials` capability (`credentials = ["modal"]`) and never sees the
/// secret: `send` attaches it to an outbound request on the host side. The
/// host refuses an unknown handle, and a request to a host outside the
/// credential's own allowed hosts, before anything is sent; the request
/// must also pass the plugin's `network` grant and the egress policy like
/// any `http.send`.
package prometheus:credentials@1.0.0;

interface handles {
    /// What a plugin may know about a credential: no secret.
    record info {
        /// Which kind of credential the handle resolved to
        /// (the `modal` handle: `direct` or `managed`).
        kind: string,
        /// The base URL requests with it go to (`https://api.modal.com`).
        origin: string,
        /// Who is billed (`subscription:nous`), when not the user's own
        /// account.
        billing-source: option<string>,
    }

    /// The outbound request; the credential's headers replace any of the
    /// same name.
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// Why a call did nothing.
    variant failure {
        /// The grant does not cover the handle (or the URL's host):
        /// `capability_denied: <capability> <detail>`.
        denied(string),
        /// The host knows no credential by that handle.
        unknown-handle(string),
        /// The credential exists but is not available, with the reason
        /// (`no Modal secrets for direct mode ...`).
        unavailable(string),
        /// The URL's host is not one the credential may be sent to.
        host-not-allowed(string),
        /// The request was sent and failed (or the URL is invalid).
        failed(string),
    }

    /// The credential behind `handle`, without its secret.
    describe: func(handle: string) -> result<info, failure>;
    /// Sends `request` with the credential attached.
    send: func(handle: string, request: request) -> result<response, failure>;
}

/// Every credentials import.
world imports {
    import handles;
}
