{
  "$defs": {
    "ProcessConfig": {
      "additionalProperties": false,
      "description": "The `[process]` section.",
      "properties": {
        "nofile_soft_limit": {
          "default": 4096,
          "description": "Open-file soft limit every process raises itself to at startup on\nPOSIX hosts, capped by the hard limit and never lowering a higher\nlimit; children inherit it. `0` disables the raise.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `daemon.toml`.",
  "properties": {
    "process": {
      "$ref": "#/$defs/ProcessConfig",
      "default": {
        "nofile_soft_limit": 4096
      },
      "description": "Limits applied to every `prometheus` process of this home."
    }
  },
  "title": "Prometheus daemon.toml",
  "type": "object",
  "x-apply": "restart"
}
