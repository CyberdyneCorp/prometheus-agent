        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "confirm": {
                    "const": true
                  },
                  "days": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "confirm"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "OK"
          },
          "403": {
            "description": "observers may not run maintenance"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "\"confirm\": true is missing"
          }
        },
        "summary": "Bulk maintenance (needs \"confirm\": true)"
